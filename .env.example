# Which AI to use: gemini (default) or anthropic
PROVIDER=gemini
# Google AI Studio key (https://aistudio.google.com/apikey). gemini-4-argon needs a PAID-tier key.
GEMINI_API_KEY=
# Only needed with PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Password players must type in the game menu before anything is sent to the AI.
GAME_PASSWORD=change-me
# Hard spending cap in US dollars (tracked in data/usage.json; delete that file to reset).
BUDGET_USD=100
# Models. Defaults: gemini-4-argon (gemini) / claude-opus-5-5 (anthropic).
MODEL=gemini-4-argon
AGENT_MODEL=gemini-4-argon
# Thinking level: low | medium | high
EFFORT=medium
AGENT_EFFORT=low
PORT=8787
# MOCK=1 returns a canned response without calling any API (for testing).
# MOCK=1

# Multiplayer economy (coins live in data/world.json on the server)
# CURRENCY=xRupee
# START_COINS=100
# ADMIN_PASSWORD=           # reads the activity log at /api/activity (defaults to GAME_PASSWORD)

# AI sandboxes (headless Chromium renders previews; see README)
# CREATOR_REVIEW=1          # rounds of preview + self-review for Creator replies that build or define creatures (0 = off)
# SANDBOX_MAX=3             # sandboxes open at once
# CHROME_PATH=/usr/bin/chromium

# On-chain economy (chain.js): xRupee is a MOCK ERC20, no real-world value
# CHAIN=off                 # keep coins in the server ledger only
# CHAIN_FORK_URL=https://mainnet.base.org   # anvil forks this (pinned at first start); unreachable = fresh local chain
# CHAIN_RPC= / CHAIN_PK=    # use another EVM chain and operator key instead of the local anvil
# CURRENCY_TOKEN=0x...      # use your own ERC20 (give the vault minter rights if the central bank should print)
# TREASURY_START=1000000    # treasury funds minted at genesis

# The nation (nation.js)
# CABINET_MINUTES=8         # how often the AI cabinet meets while people are online (/nation off pauses it)
